# Server
PORT=3001

# Groq (required)
GROQ_API_KEY=your_groq_api_key_here
# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# CORS: single origin allowed to call this API.
FRONTEND_URL=http://localhost:8080

# Optional abuse protection (defaults shown)
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=60000
JSON_BODY_LIMIT=16kb

# Full system prompt. Keep your real prompt in .env / Render, never in git.
AI_SYSTEM_PROMPT=""
# Optional additional context appended to the prompt.
AI_CONTEXT=""
